{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022"],
    "strict": true, "noImplicitAny": false, "skipLibCheck": true, "noEmit": true, "isolatedModules": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types", "node"]
  },
  "include": ["src/worker", "src/shared", "src/demo", "test/api", "test/unit", "scripts", "vitest.config.ts"]
}
