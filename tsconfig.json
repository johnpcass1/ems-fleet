{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false, "strictNullChecks": false, "noEmit": true, "skipLibCheck": true, "isolatedModules": true, "types": ["vite/client"],
    "noImplicitAny": false
  },
  "include": ["src/client", "src/shared"]
}
