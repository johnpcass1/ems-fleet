{
  "name": "gema-fleet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GEMA Fleet: fleet maintenance web app for the Guyana EMS ambulance program (Cloudflare Workers + D1 + R2)",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --env staging",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "import:prototype": "tsx scripts/import-prototype.ts",
    "create-admin": "tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^26.6.6",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
