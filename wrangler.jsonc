{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gema-fleet",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gema-fleet",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "gema-fleet-files" }
  ],
  "triggers": {
    // Backup steps run every 2 minutes during the 07:00 UTC hour (03:00 in Guyana).
    // Each run does a small piece of work, so it fits the free plan's 10 ms CPU limit.
    "crons": ["*/2 7 * * *"]
  },
  "vars": {
    "APP_URL": "https://gema-fleet.example.workers.dev",
    "PBKDF2_ITERATIONS": "20000"
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "gema-fleet-staging",
      "workers_dev": true,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gema-fleet-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "gema-fleet-files-staging" }
      ],
      "triggers": { "crons": ["*/2 7 * * *"] },
      "vars": {
        "APP_URL": "https://gema-fleet-staging.example.workers.dev",
        "PBKDF2_ITERATIONS": "20000"
      }
    }
  }
}
